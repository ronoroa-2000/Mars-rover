<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rgbd_camera">

    <!-- Mount point on the chassis -->
    <joint name="camera_mount_joint" type="fixed">
        <origin xyz="0.2756 0.0025 0.2535" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="camera_center"/>
    </joint>

    <link name="camera_center">
        <visual>
            <geometry>
                <box size="0.175 0.030 0.033"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.175 0.030 0.033"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.166"/>
            <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
        </inertial>
    </link>

    <!-- Optical frame follows the ROS camera convention (x-right, y-down, z-forward) -->
    <joint name="left_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
        <parent link="camera_center"/>
        <child link="left_camera_frame_optical"/>
    </joint>

    <link name="left_camera_frame_optical"/>

    <!-- Gazebo configuration for Ionic/ROS2 Jazzy -->
    <xacro:if value="${enable_rgbd_camera}">
        <gazebo reference="camera_center">
            <self_collide>0</self_collide>
            <enable_wind>0</enable_wind>
            <kinematic>0</kinematic>
            <mu2>1</mu2>
            <fdir1>0 0 0</fdir1>
            <kp>1e+13</kp>
            <kd>1</kd>

            <!-- Left color camera - 15 Hz, matching the rest of the rig's render budget -->
            <sensor name="camera_left_color" type="camera">
                <camera name="camera_left">
                    <horizontal_fov>1.8</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>RGB_INT8</format>
                    </image>
                    <clip>
                        <near>0.2</near>
                        <far>20</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                </camera>
                <always_on>1</always_on>
                <update_rate>15</update_rate>
                <visualize>false</visualize>
                <topic>camera/left/image_rect_color</topic>
                <gz_frame_id>left_camera_frame_optical</gz_frame_id>
            </sensor>

            <!-- Depth, registered to the left camera -->
            <sensor name="camera_depth" type="depth_camera">
                <camera name="camera_depth">
                    <horizontal_fov>1.8</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R_FLOAT32</format>
                    </image>
                    <clip>
                        <near>0.2</near>
                        <far>20</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.010</stddev>
                    </noise>
                </camera>
                <always_on>1</always_on>
                <update_rate>15</update_rate>
                <visualize>false</visualize>
                <topic>camera/depth/depth_registered</topic>
                <gz_frame_id>left_camera_frame_optical</gz_frame_id>
            </sensor>
        </gazebo>
    </xacro:if>
</robot>
