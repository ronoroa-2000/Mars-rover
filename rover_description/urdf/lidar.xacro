<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="lidar_radius" value="0.03" />
    <xacro:property name="lidar_length" value="0.04" />
    <xacro:property name="lidar_mass" value="0.1" />

    <xacro:macro name="cylinder_inertia" params="m r h xyz rpy">
        <inertial>
            <origin xyz="${xyz}" rpy="${rpy}" />
            <mass value="${m}" />
            <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
                     iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
                     izz="${(m/2) * (r*r)}" />
        </inertial>
    </xacro:macro>

    <link name="lidar_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
            <material name="lidar_black">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_length}"/>
            </geometry>
        </collision>
        <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_length}"
                                xyz="0 0 0" rpy="0 0 0" />
    </link>

    <!-- TODO: set to the real mounting position on the rover -->
    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="0.15 0 0.30" rpy="0 0 0" />
    </joint>

   <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
        <lidar>
            <scan>
                <horizontal>
                    <samples>1024</samples>          <!-- points per ring -->
                    <resolution>1</resolution>
                    <min_angle>${-pi}</min_angle>
                    <max_angle>${pi}</max_angle>     <!-- full 360° -->
                </horizontal>
                <vertical>
                    <samples>50</samples>           <!-- 100 layers -->
                    <resolution>1</resolution>
                    <min_angle>${-22.5*pi/180}</min_angle>
                    <max_angle>${22.5*pi/180}</max_angle>   <!-- 45° vertical FOV, like an OS1 -->
                </vertical>
            </scan>
            <range>
                <min>0.3</min>
                <max>100.0</max>
                <resolution>0.01</resolution>
            </range>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
            </noise>
        </lidar>
        <gz_frame_id>lidar_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>scan</topic>
    </sensor>
</gazebo>
                                                                  

</robot>
