<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_sim" default="true"/>

  <!-- ================================================================
       SIMULATION  (gz_ros2_control/GazeboSimSystem)
       ================================================================ -->
  <xacro:if value="$(arg use_sim)">

    <ros2_control name="RobotSystem" type="system">

      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <!-- ROCKER JOINTS -->
      <joint name="aux_L_Rocker_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="aux_R_Rocker_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- LEFT WHEELS -->
      <joint name="L_1_Wheel_Joint">
        <command_interface name="velocity">
          <param name="min">-200</param>
          <param name="max">200</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="L_2_Wheel_Joint">
        <command_interface name="velocity">
          <param name="min">-200</param>
          <param name="max">200</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="L_3_Wheel_Joint">
        <command_interface name="velocity">
          <param name="min">-200</param>
          <param name="max">200</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- RIGHT WHEELS -->
      <joint name="R_1_Wheel_Joint">
        <command_interface name="velocity">
          <param name="min">-200</param>
          <param name="max">200</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="R_2_Wheel_Joint">
        <command_interface name="velocity">
          <param name="min">-200</param>
          <param name="max">200</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="R_3_Wheel_Joint">
        <command_interface name="velocity">
          <param name="min">-200</param>
          <param name="max">200</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>
          $(find rover_controllers)/config/diff_controller.yaml
        </parameters>
      </plugin>
    </gazebo>

  </xacro:if>

  <!-- ================================================================
       REAL HARDWARE  (ODrive S1 x6 via CAN bus)
       Velocity limits: ±11.52 rad/s (110 RPM rated, r=0.110 m → ~1.27 m/s)
       Effort limits  : ±5 Nm (motor rated torque)
       ================================================================ -->
  <xacro:unless value="$(arg use_sim)">

    <ros2_control name="RobotSystem" type="system">

      <hardware>
        <plugin>odrive_ros2_control_plugin/ODriveHardwareInterface</plugin>
        <param name="can">can0</param>
      </hardware>

      <!-- LEFT WHEELS -->
      <joint name="L_1_Wheel_Joint">
        <param name="node_id">3</param>
        <command_interface name="velocity">
          <param name="min">-11.52</param>
          <param name="max"> 11.52</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">-5</param>
          <param name="max"> 5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="L_2_Wheel_Joint">
        <param name="node_id">4</param>
        <command_interface name="velocity">
          <param name="min">-11.52</param>
          <param name="max"> 11.52</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">-5</param>
          <param name="max"> 5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="L_3_Wheel_Joint">
        <param name="node_id">5</param>
        <command_interface name="velocity">
          <param name="min">-11.52</param>
          <param name="max"> 11.52</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">-5</param>
          <param name="max"> 5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- RIGHT WHEELS -->
      <joint name="R_1_Wheel_Joint">
        <param name="node_id">2</param>
        <command_interface name="velocity">
          <param name="min">-11.52</param>
          <param name="max"> 11.52</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">-5</param>
          <param name="max"> 5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="R_2_Wheel_Joint">
        <param name="node_id">1</param>
        <command_interface name="velocity">
          <param name="min">-11.52</param>
          <param name="max"> 11.52</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">-5</param>
          <param name="max"> 5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="R_3_Wheel_Joint">
        <param name="node_id">0</param>
        <command_interface name="velocity">
          <param name="min">-11.52</param>
          <param name="max"> 11.52</param>
        </command_interface>
        <command_interface name="effort">
          <param name="min">-5</param>
          <param name="max"> 5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

    </ros2_control>

  </xacro:unless>

</robot>
