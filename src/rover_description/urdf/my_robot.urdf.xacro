<?xml version="1.0"?>
<robot name="aries" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- <xacro:arg name="gripper_hardware_protocol" default="$(arg hardware_protocol)" />
    <xacro:property name="gripper_hardware_protocol" value="$(arg gripper_hardware_protocol)" /> -->

    <!-- Teensy gripper serial port (only used when hardware_protocol=rebel) -->
    <!-- <xacro:arg name="serial_port" default="/dev/ttyACM0" /> -->
    <!-- <xacro:property name="serial_port" value="$(arg serial_port)" /> -->

    <!-- Flip right wheel joint axes for RViz display only; pass invert_right_wheels:=true
         in the display description and leave it false for the hardware description. -->
    <xacro:arg name="invert_right_wheels" default="false"/>

    <xacro:include filename="common_properties.xacro" />
    <xacro:include filename="aries_gazebo.xacro" />
    <xacro:include filename="aries_base.xacro" />
    <xacro:include filename="differential_link.xacro" />
    <xacro:include filename="left_link.xacro" />
    <xacro:include filename="right_link.xacro" />
    <xacro:include filename="rover_control.xacro" />

    <!-- <xacro:include filename="lidar.xacro" /> -->
    <!-- <xacro:include filename="camera.xacro" /> -->
    
   <!-- <xacro:include filename="d435i.xacro" /> -->
    <!-- <xacro:include filename="arm.xacro" /> -->
    <!-- <xacro:include filename="igus_rebel_robot2.urdf.xacro" /> -->
    <!-- <xacro:include filename="igus_rebel2.control.xacro" /> -->

    

</robot>